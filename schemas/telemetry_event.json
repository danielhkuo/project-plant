{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/danielkuo/project-plant/schemas/telemetry_event.json",
  "title": "TelemetryEvent",
  "description": "A single telemetry reading from a plant sensor device",
  "type": "object",
  "properties": {
    "device_id": {
      "type": "string",
      "minLength": 1,
      "description": "Unique identifier for the device"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp of the reading"
    },
    "temperature": {
      "type": "number",
      "minimum": -40,
      "maximum": 80,
      "description": "Temperature in degrees Celsius"
    },
    "humidity": {
      "type": "number",
      "minimum": 0,
      "maximum": 100,
      "description": "Relative humidity percentage"
    },
    "soil_moisture": {
      "type": "number",
      "minimum": 0,
      "maximum": 100,
      "description": "Soil moisture percentage"
    }
  },
  "required": ["device_id", "timestamp", "temperature", "humidity", "soil_moisture"],
  "additionalProperties": false
}
