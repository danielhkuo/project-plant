# Next.js environment variables — copy to .env.local for local dev
# WebSocket URL (direct connection, not via rewrite — rewrites don't handle WS upgrades)
NEXT_PUBLIC_WS_URL=ws://localhost:8081

# Demo mode: set to "true" to run the dashboard without a backend.
# MSW intercepts /api/v1/* requests and serves fixture data; a 2s tick
# simulates live telemetry updates. Leave unset (or false) for real backend.
# NEXT_PUBLIC_DEMO_MODE=true
